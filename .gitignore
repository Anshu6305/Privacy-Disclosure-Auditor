# ---------------------------------------------------------------
# Datasets and collected corpora are NEVER committed.
# OPP-115 is released for research and teaching use and is not ours
# to redistribute. The Play Store corpus and policy documents are
# third-party content. Each team member obtains these locally using
# the instructions in data/README.md.
# ---------------------------------------------------------------
data/*
!data/README.md
!data/.gitkeep

# Trained model weights and checkpoints (large, regenerable)
ml/checkpoints/
ml/runs/
*.pt
*.bin
*.safetensors
*.joblib
*.pkl

# Secrets and local configuration
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
.DS_Store

# Migration verification logs, produced by scripts/verify_migrations.sh
c53_verification_*.log
migration_verification_*.log

# Generated F-12 span dataset
data/processed/opp115_spans.jsonl
ml/checkpoints/

# Vitest rewrites vite.config.js to a temporary module on each run and cannot
# always remove it afterwards. These are build scratch, never source.
frontend/vite.config.js.timestamp-*

# ---------------------------------------------------------------
# FINAL_FACULTY_SUBMISSION: the approved Phase 1-3 reports and the
# diagram set are committed because they are the academic baseline
# and exist nowhere else in the repository. The rest of that folder
# is derived - a copy of docs/, a copy of the source tree and the
# diagrams unpacked from the committed zip - and is regenerated by
# re-running the submission build, so it is not committed twice.
# ---------------------------------------------------------------
FINAL_FACULTY_SUBMISSION/03_Phase_3_System_Design/diagrams/
FINAL_FACULTY_SUBMISSION/04_Phase_4_Implementation_Documentation/
FINAL_FACULTY_SUBMISSION/05_Testing_Evidence/
FINAL_FACULTY_SUBMISSION/06_Project_Source_Code/
