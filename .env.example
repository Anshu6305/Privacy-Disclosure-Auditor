# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- Database ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=privacy_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# ---- Application -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Where raw policy documents are stored on disk (NFR: database stores no bodies)
POLICY_STORAGE_DIR=./data/policies/raw

# ---- Analysis pipeline -------------------------------------------------
# Confidence thresholds (ALG-4). Values are placeholders until tuned on the
# gold set in Milestone 6. They must not be treated as measured results.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50
SPAN_CONFIDENCE_THRESHOLD=0.50
ALIGNMENT_CONFIDENCE_THRESHOLD=0.50

# ---- Worker ------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CLAIM_TIMEOUT_SECONDS=900

# ---- Acquisition (E11, team-facing only) -------------------------------
# Delay between successive Play Store requests, per NFR-15. Do not lower.
ACQUISITION_REQUEST_DELAY_SECONDS=3
ACQUISITION_USER_AGENT=KIIT-MajorProject-Research/1.0
